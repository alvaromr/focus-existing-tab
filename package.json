{
  "name": "focus-existing-tab",
  "version": "1.0.0",
  "description": "Chrome MV3 extension: focus an already open tab instead of loading the same URL twice.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'test/**/*.test.js'",
    "test:e2e": "node test/e2e/smoke.js",
    "mutation": "nice -n 10 stryker run",
    "lint": "eslint . && prettier --check . && shellcheck scripts/*.sh scripts/ci/*.sh .githooks/*",
    "format": "prettier --write .",
    "fix": "eslint --fix . && prettier --write . && pnpm check",
    "typecheck": "tsc -p jsconfig.json",
    "guards": "gitleaks git --no-banner --redact --log-level warn . && node scripts/check-file-size.js",
    "check": "pnpm lint && pnpm typecheck && pnpm guards && pnpm coverage",
    "verify": "pnpm check && pnpm audit && pnpm mutation && pnpm test:e2e",
    "audit": "pnpm audit",
    "prepare": "git config core.hooksPath .githooks",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/screenshots.js",
    "package": "bash scripts/package.sh",
    "smoke:package": "bash scripts/smoke-package.sh",
    "release": "node scripts/release.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alvaromr/focus-existing-tab.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/chrome": "0.3.7",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
