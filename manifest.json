{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Focus Tab",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "webNavigation", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "dedupe-all": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "__MSG_cmdDedupeAll__"
    },
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmdToggle__"
    }
  }
}
